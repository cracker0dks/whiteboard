{
  "name": "whiteboard",
  "version": "1.0.0",
  "description": "Collaborative Whiteboard / Sketchboard",
  "main": "scripts/server.js",
  "directories": {},
  "type": "module",
  "scripts": {
    "build": "webpack --config config/webpack.build.js",
    "start:dev": "apidoc -i scripts/ -o ./public/apidoc/ && node scripts/server.js --mode=development",
    "start:prod": "npm run build && npm run start",
    "start": "apidoc -i scripts/ -o ./dist/apidoc/ && node scripts/server.js --mode=production",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "pretty-quick": "pretty-quick",
    "format": "prettier --write .",
    "style": "prettier --check .",
    "precommit": "npx lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,json,yml,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cracker0dks/whiteboard"
  },
  "keywords": [
    "whiteboard",
    "Sketchboard",
    "lightweight"
  ],
  "dependencies": {
    "ajv": "^8.12.0",
    "apidoc": "^1.2.0",
    "dompurify": "^3.4.14",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "fs-extra": "^11.1.1",
    "html2canvas": "^1.4.1",
    "jquery-ui-rotatable": "^1.1.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.4.0",
    "uuid": "^14.0.2",
    "webdav": "^5.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jquery": "^3.6.0",
    "jquery-ui": "^1.13.2",
    "keymage": "^1.1.3",
    "lint-staged": "^17.4.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.8.1",
    "style-loader": "^4.0.0",
    "vanilla-picker": "^2.12.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "author": "Cracker0dks",
  "license": "MIT",
  "private": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}
